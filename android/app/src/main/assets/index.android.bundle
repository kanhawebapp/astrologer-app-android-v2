0932 \u092e\u0940\u0921\u093f\u092f\u093e \u092f\u0942\u091c\u093c\u0930\u0928\u0947\u092e \u0938\u093e\u091d\u093e \u0928 \u0915\u0930\u0947\u0902\u0964'},{id:'hi-2',text:'\u0906\u092a\u0915\u094b \u0939\u0930 \u0926\u093f\u0928 \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u096a \u0918\u0902\u091f\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964'},{id:'hi-3',text:'\u091c\u092c \u092d\u0940 \u0906\u092a \u0911\u0928\u0932\u093e\u0907\u0928 \u0939\u094b\u0902, \u0938\u092d\u0940 \u0915\u0949\u0932\u094d\u0938 \u0914\u0930 \u091a\u0948\u091f\u094d\u0938 \u0915\u094b \u0939\u092e\u0947\u0936\u093e \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902\u0964'},{id:'hi-4',text:'\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u093e \u0909\u091a\u093f\u0924 \u0938\u094d\u0935\u093e\u0917\u0924 \u0928\u094b\u091f \u0915\u0947 \u0938\u093e\u0925 \u0905\u092d\u093f\u0935\u093e\u0926\u0928 \u0915\u0930\u0947\u0902 \u091c\u0948\u0938\u0947: "\u0927\u094d\u0935\u0928\u093f \u090f\u0938\u094d\u091f\u094d\u0930\u094b \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0948," \u092f\u093e "\u0928\u092e\u0938\u094d\u0924\u0947, \u0906\u092a\u0915\u093e \u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0948," \u092f\u093e \u091c\u094b \u092d\u0940 \u0905\u092d\u093f\u0935\u093e\u0926\u0928 \u0906\u092a\u0915\u094b \u0938\u0941\u0935\u093f\u0927\u093e\u091c\u0928\u0915 \u0932\u0917\u0947\u0964'},{id:'hi-5',text:'\u0939\u0930 \u0924\u0930\u0939 \u0938\u0947 \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0938\u092e\u094d\u092e\u093e\u0928\u091c\u0928\u0915 \u0914\u0930 \u0935\u093f\u0928\u092e\u094d\u0930 \u0930\u0939\u0947\u0902\u0964'},{id:'hi-6',text:'\u0915\u093f\u0938\u0940 \u092d\u0940 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0938\u0947 \u0905\u0936\u093f\u0937\u094d\u091f\u0924\u093e \u0938\u0947 